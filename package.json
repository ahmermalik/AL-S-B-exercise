{
  "name": "asset-living-close",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx scripts/dev.ts",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker.ts",
    "setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evaluate:ai": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-ai.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "1.7.14",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.9.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "openai": "7.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
